{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2023",
    "lib": ["ES2023"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // NestJS 依赖装饰器元数据
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // 装饰器注入的可选属性与 strictPropertyInitialization 冲突
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
