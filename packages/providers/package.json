{
  "name": "@june/providers",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"@june/providers: 由根 prettier 统一格式化\""
  },
  "dependencies": {
    "@june/shared": "workspace:*",
    "undici": "8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
