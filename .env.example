# ============================================================================
# JUNE-Commerce-Platform 环境变量模板
# ----------------------------------------------------------------------------
# 复制为 .env 后填写。生产环境请使用密钥管理服务注入,禁止把真实密钥提交入库。
# 所有 *_SECRET / *_KEY 必须替换,示例值不可用于生产。
# 生成随机密钥:openssl rand -base64 48
# ============================================================================

# ---------- 运行环境 ----------
NODE_ENV=development
# 平台对外主域名(用于分享链接、微信 JS-SDK 签名、Cookie 域)
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_API_ORIGIN=http://localhost:3001
# 允许的浏览器来源,逗号分隔(CORS 白名单)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cookie 作用域。生产环境填写 .example.com;localhost 留空
COOKIE_DOMAIN=
# 反向代理层数,Nginx 单层填 1(用于正确解析 X-Forwarded-For 做限流)
TRUST_PROXY_HOPS=1

# ---------- 服务端口 ----------
API_PORT=3001
WEB_PORT=3000
WORKER_METRICS_PORT=3002

# ---------- PostgreSQL ----------
POSTGRES_USER=june
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=june
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://june:change-me-postgres@localhost:5432/june?schema=public
# Prisma migrate 影子库(仅本地开发需要,生产迁移用 migrate deploy 不需要)
SHADOW_DATABASE_URL=
# 连接池:API 与 Worker 分开配置,总数需 < PostgreSQL max_connections 并预留维护余量
# 详见 docs/PERFORMANCE.md 的连接数预算表
API_DB_POOL_MAX=20
API_DB_POOL_IDLE_TIMEOUT_MS=30000
API_DB_STATEMENT_TIMEOUT_MS=15000
WORKER_DB_POOL_MAX=10
WORKER_DB_STATEMENT_TIMEOUT_MS=60000

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# 队列与缓存使用不同 db,避免 FLUSH 缓存影响队列
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1
# 队列键前缀
QUEUE_PREFIX=june

# ---------- 会话与安全 ----------
# 会话 Cookie 签名密钥(至少 32 字节随机值)
SESSION_SECRET=change-me-session-secret-at-least-32-bytes-long
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=72
# CSRF 双提交 Cookie 密钥
CSRF_SECRET=change-me-csrf-secret-at-least-32-bytes-long
# 店铺密码可逆加密主密钥:base64 编码的 32 字节(AES-256-GCM)
# 生成:openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# 密钥轮换用的旧密钥(逗号分隔的 base64,只用于解密历史数据)
CREDENTIAL_ENCRYPTION_KEY_OLD=
# 供应商 API Key 加密主密钥(与店铺凭据分离)
PROVIDER_SECRET_ENCRYPTION_KEY=
# 查看/复制店铺密码前的重新验证有效期(秒)
REAUTH_TTL_SECONDS=300
# Argon2id 参数(内存 KiB / 迭代 / 并行度)
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

# ---------- 对象存储(S3 兼容:AWS S3 / 阿里云 OSS / 腾讯云 COS / MinIO)----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=june-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 等需要 path-style 寻址
S3_FORCE_PATH_STYLE=true
# 公共读资源的 CDN / 公网前缀(公开帖子图)。留空则统一走签名 URL
S3_PUBLIC_BASE_URL=
# 私有资源签名 URL 有效期(秒)
S3_SIGNED_URL_TTL_SECONDS=600
# 直传签名有效期(秒)
S3_UPLOAD_URL_TTL_SECONDS=300
# 单文件上限(字节),默认 20MB
UPLOAD_MAX_BYTES=20971520
# 每用户默认存储配额(字节),默认 5GB
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
# 已删除文件回收期(天),回收期内不物理删除
ASSET_RECYCLE_DAYS=14
# 未关联业务的临时上传宽限期(小时)
ASSET_ORPHAN_GRACE_HOURS=24

# ---------- 队列并发(可在管理后台覆盖,此处为启动初值)----------
CONCURRENCY_IMAGE_GLOBAL=5
CONCURRENCY_TEXT_GLOBAL=10
CONCURRENCY_IMAGE_PER_USER_RUNNING=1
CONCURRENCY_IMAGE_PER_USER_PENDING=3
CONCURRENCY_IMAGE_PROCESS=2
QUEUE_MAX_DEPTH_IMAGE=500
QUEUE_MAX_DEPTH_TEXT=1000
# 单个生图任务超时(毫秒)
TASK_IMAGE_TIMEOUT_MS=300000
TASK_TEXT_TIMEOUT_MS=120000
# 异步供应商轮询间隔与上限
PROVIDER_POLL_INTERVAL_MS=3000
PROVIDER_POLL_MAX_ATTEMPTS=100

# ---------- 供应商凭据 ----------
# 说明:生产环境优先在 /admin 模型管理中录入(加密存库)。
# 以下环境变量仅作为兜底/本地联调,留空则对应模型标记为"未配置凭据",前端不可选。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# 火山方舟(Seedream)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 阿里云通义万相(DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Black Forest Labs FLUX
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai
# 压测用的可控模拟供应商(仅用于容量压测,结果带 MOCK 标识)
MOCK_PROVIDER_BASE_URL=http://localhost:4010
MOCK_PROVIDER_ENABLED=false
# API 地址白名单模式:禁止配置指向内网地址的 API Base URL(防 SSRF)
PROVIDER_URL_ALLOW_PRIVATE_NETWORK=false

# ---------- 分享(微信 / QQ)----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 微信 JS-SDK 需要在公众号后台配置 JS 安全域名
WECHAT_JS_API_DOMAIN=
QQ_SHARE_APP_ID=

# ---------- 管理员初始化(pnpm admin:init 读取,执行后建议清空)----------
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=
ADMIN_INIT_DISPLAY_NAME=

# ---------- 可观测性 ----------
LOG_LEVEL=info
# 慢查询阈值(毫秒),超过记录到日志
SLOW_QUERY_THRESHOLD_MS=300
# 是否输出 SQL(仅开发)
LOG_SQL=false
# 健康检查详情需要的内部令牌(留空则 /health/detail 仅内网可访问)
HEALTH_DETAIL_TOKEN=

# ---------- 限流 ----------
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=60
RATE_LIMIT_AI_SUBMIT_PER_MINUTE=20

# ---------- 备份 ----------
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_LOCAL_DIR=/var/backups/june
