{
  "name": "@june/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc-watch -p tsconfig.build.json --preserveWatchOutput --onSuccess \"node dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"@june/api: 由根 prettier 统一格式化\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@june/db": "workspace:*",
    "@june/providers": "workspace:*",
    "@june/shared": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.2.1",
    "archiver": "8.0.0",
    "bullmq": "5.81.5",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.4",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nanoid": "3.3.19",
    "papaparse": "5.7.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@types/archiver": "8.0.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "tsc-watch": "^7.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
